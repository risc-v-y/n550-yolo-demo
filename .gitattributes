* text=auto
*.sh text eol=lf
*.S text eol=lf
*.c text eol=lf
*.h text eol=lf
*.ld text eol=lf
*.bin binary
*.pt binary
*.jpg binary
*.png binary
*.mp4 binary
*.whl binary
/host_deps/**/SHA256SUMS text eol=lf
*.gz.part* binary
# Frozen generated assets retain byte-identical hashes across clones.
/model/model_generated.c -text whitespace=cr-at-eol
/model/model_generated.h -text whitespace=cr-at-eol
# Prebuilt handoff artifacts and checksums must retain exact bytes across hosts.
/firmware/* -text -whitespace
# Generated audit hashes bind exact LF bytes across Windows/Linux checkouts.
/docs/operator-audit.csv text eol=lf
/docs/operator-audit.json text eol=lf
